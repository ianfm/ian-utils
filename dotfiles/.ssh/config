# Example ~/.ssh/config. Hostnames, IPs, users and key names are all dummies --
# substitute your own. The point is the shape of the Host blocks.

Host printer-pi
    HostName 192.168.1.10
    User pi

Host github.com
    HostName github.com
    IdentityFile ~/.ssh/github-key
    # IdentityFile ~/.ssh/id_rsa

Host lab-pi
    HostName 192.168.1.11
    User pi

# host that resolves by name on the LAN rather than by IP
Host rf-pi
    HostName rf-pi
    User ubuntu
    IdentityFile ~/.ssh/id_rsa_ubuntu
    PreferredAuthentications publickey
    # RemoteCommand

Host octopi
    HostName octopi
    User pi
    # IdentityFile ~/.ssh/id_rsa_octopi
    # PreferredAuthentications publickey

# a second github identity, e.g. for a work account
# Host work_github
#     HostName github.com
#     IdentityFile ~/.ssh/id_rsa_work_github


# Jetsons, keyed individually. Windows-style IdentityFile paths because this
# config gets used from Windows as well as Linux.
Host jetson-a
    User ubuntu
    IdentityFile C:\Users\username\.ssh\id_jetson_a
    PreferredAuthentications publickey
    IdentitiesOnly yes
    ForwardX11 yes

Host jetson-b
    User ubuntu
    IdentityFile C:\Users\username\.ssh\id_jetson_b
    PreferredAuthentications publickey
    IdentitiesOnly yes
    ForwardX11 yes

Host robot
    User myuser
    IdentityFile C:\Users\username\.ssh\id_robot
    PreferredAuthentications publickey
    IdentitiesOnly yes
    ForwardX11 yes

Host xavier
    HostName xavier
    User ubuntu
    IdentityFile C:\Users\username\.ssh\id_xavier
    PreferredAuthentications publickey
    IdentitiesOnly yes
    ForwardX11 yes

# one Host line can carry several aliases for the same machine
# Host 192.168.1.240 192.168.1.48 xavier
#     Hostname xavier
#     User ubuntu


# password auth instead of a key, for a box you do not control
Host shared-pi
    HostName 192.168.1.12
    User someuser
    PreferredAuthentications password
    IdentitiesOnly yes
    ForwardX11 yes
